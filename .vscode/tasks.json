{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: Build",
            "command": "build",
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build ligarium_demo",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug",
                "--target",
                "ligarium_demo",
                "-j",
                "4"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}